# Keep this server-only. For Layerbase, use the pooled PostgreSQL URL and include sslmode=require.
DATABASE_URL="postgresql://user:password@your-host.cloud.layerbase.dev:5432/app?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NEXT_PUBLIC_DB_URL is still accepted for compatibility, but DATABASE_URL is safer.
